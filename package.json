{
  "name": "geospatial-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered Geospatial Intelligence Platform (wildfire early warning) on Cloudflare — MVP for Aragón.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:apply:local": "wrangler d1 migrations apply geospatial-db --local",
    "db:apply:remote": "wrangler d1 migrations apply geospatial-db --remote",
    "twin:build": "node scripts/build-digital-twin.mjs",
    "weather:grid": "node scripts/build-weather-grid.mjs",
    "twin:apply:local": "wrangler d1 execute geospatial-db --local --file tmp/digital-twin.sql",
    "twin:apply:remote": "wrangler d1 execute geospatial-db --remote --file tmp/digital-twin.sql",
    "map:build": "node prototype/build-geojson.mjs && node scripts/map-metadata.mjs",
    "map:deploy": "wrangler pages deploy prototype --project-name geospatial-platform-map --branch main --commit-dirty=true",
    "map:dev": "node scripts/map-dev.mjs",
    "map:check": "node --check prototype/map.js && node --check scripts/map-dev.mjs && node --check scripts/map-smoke.mjs && node --check prototype/terrain.js && node --test scripts/terrain.test.mjs && node --check scripts/map-metadata.mjs",
    "map:smoke": "node scripts/map-smoke.mjs",
    "audit:lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "h3-js": "^4.1.0",
    "omggif": "^1.0.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260710.1": true
  }
}
